{
  "name": "yaybmt-static",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "python3 scripts/serve-export.py",
    "test:browser": "node --import tsx scripts/check-browser.ts && node --import tsx scripts/check-drawings-browser.ts && npm run test:home && npm run test:paragraphs && npm run test:team && npm run test:company && npm run test:gallery && npm run test:brands && npm run test:testimonials && npm run test:menu && npm run test:home-drop && npm run test:focus",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check:export": "node --import tsx scripts/check-export.ts",
    "check:focus": "node --import tsx scripts/check-focus-products.ts",
    "manifest": "node --import tsx scripts/generate-manifest.ts",
    "test:catalogue": "node --import tsx --test scripts/catalogue.test.ts scripts/image-import.test.ts",
    "test:import": "python3 scripts/test-importer.py",
    "check": "npm run typecheck && npm run check:content && npm run check:focus && npm run test:media && npm run test:catalogue && npm run test:import",
    "prebuild": "npm run check:content",
    "format": "prettier --write app components data lib scripts/*.ts next.config.ts tsconfig.json firebase.json",
    "assets:optimise": "node scripts/optimise-assets.mjs",
    "test:media": "node --import tsx scripts/check-media.ts && node --import tsx scripts/check-drawings.ts",
    "test:home": "node --import tsx scripts/check-home-design.ts",
    "test:paragraphs": "node --import tsx scripts/check-paragraph-motion.ts",
    "test:team": "node --import tsx scripts/check-team-section.ts",
    "test:company": "node --import tsx scripts/check-company-motion.ts",
    "test:gallery": "node --import tsx scripts/check-showroom-gallery.ts",
    "test:brands": "node --import tsx scripts/check-brand-cloud.ts",
    "test:testimonials": "node --import tsx scripts/check-testimonials.ts",
    "test:menu": "node --import tsx scripts/check-menu-hover.ts",
    "test:home-drop": "node --import tsx scripts/check-home-drop.ts",
    "test:focus": "node --import tsx scripts/check-focus-browser.ts"
  },
  "dependencies": {
    "motion": "12.40.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
